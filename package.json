{
  "name": "vfs-neuro-symbolic",
  "version": "0.1.0",
  "description": "VFS Neuro-Symbolic Research System — Node.js/TypeScript CLI",
  "type": "module",
  "bin": {
    "vfs": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@clack/prompts": "^0.9.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "dotenv": "^16.4.0",
    "sql.js": "^1.12.0",
    "chalk": "^5.3.0",
    "clingo-wasm": "^0.3.2",
    "commander": "^12.0.0",
    "csv-parse": "^5.5.6",
    "fastify": "^5.0.0",
    "neo4j-driver": "^5.0.0",
    "p-retry": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "undici": "^6.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/pdf-parse": "^1.1.4",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
